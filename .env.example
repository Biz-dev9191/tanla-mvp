# AI Orchestrator LLM API Keys (Optional - built-in robust engine active if omitted)

# 1. Google Gemini API Key (Direct from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. OpenRouter API Key (Supports Gemini, Claude, Llama from https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL="google/gemini-flash-1.5"

# 3. OpenAI API Key (Direct from https://platform.openai.com)
OPENAI_API_KEY=

# 4. Live Outbound Email Provider (Free tier from https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM="Aurora Cloud <onboarding@resend.dev>"

# 5. App Configuration
NEXT_PUBLIC_APP_NAME="Aurora Cloud · AI Communication Orchestrator"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
